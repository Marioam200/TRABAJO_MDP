panel.cor <- function(x, y, digits = 2, prefix = "", cex.cor, ...)
{
    par(usr = c(0, 1, 0, 1))
    r <- cor(x, y)
    txt <- format(c(r, 0.123456789), digits = digits)[1]
    txt <- paste0(prefix, txt)
    if(missing(cex.cor)) cex.cor <- 0.8/strwidth(txt)
    text(0.5, 0.5, txt, cex = cex.cor * abs(r))
}

get_variables_greatest_contrib <- function(res.pca, dim, n) {
    # Get the contributions of variables to the specified dimension
    contrib <- res.pca$var$contrib[, dim]
    # Select variables greater than the mean ordered by values
    contrib <- contrib[order(contrib, decreasing = TRUE)]
    
    # if n is not specified, return variables greater than mean, otherwise, return top n variables
    if (missing(n)) {
        contrib <- contrib[contrib > mean(contrib)]
    } else {
        contrib <- contrib[1:n]
    }
    # Select an array with the names of variables
    contrib_greater_mean_names <- names(contrib)
    return(contrib_greater_mean_names)
}

